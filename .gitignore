node_modules/
.turbo/
coverage/
*.tsbuildinfo
.DS_Store
.env*.local

# Secrets (defence in depth: signing keys and credentials live outside the repository)
*.jks
*.keystore
*.p12
*.pfx
*.key.json
.env
.env.*
# Test-only key of the local E2E mirror; debug builds trust its CA for 127.0.0.1 only (see its README).
!e2e/mirror/certs/server.key

# Provisioned content (large, never committed)
.cache/
*.zim
# Small test fixtures are the exception (see their README).
!modules/expo-zim/android/src/androidTest/assets/*.zim
*.gguf
*.pmtiles

# Bench/E2E outputs
e2e/out/
AGENTS.md
# rag-eval fixture ZIMs (<= 5 MB, built by tools/rag-eval/scripts/build_eval_zims.py) are committed for CI.
!tools/rag-eval/fixtures/*.zim

# Rust build output
/target/

# Small E2E map fixture (OSM via Protomaps, ODbL; see its README)
!apps/desktop/e2e/fixtures/*.pmtiles
e2e/station-receive.gen.yaml
# P2P/Station propagation fixture (CC0, 60 KB): its SHA-256 is pinned in the signed test catalogs, so
# the committed bytes are the fixture (e2e/fixtures/build_p2p_zim.py output is not reproducible).
!e2e/fixtures/p2p-propagation.zim
