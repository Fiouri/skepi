* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.webp binary
*.jar binary
*.pbf binary
*.aar binary
*.zim binary
*.jks binary

# Signed catalogs: the Ed25519 signature covers the exact bytes; never normalise them.
catalog/embedded/** -text
e2e/mirror/catalogs/** -text
