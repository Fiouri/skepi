{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window only: the narrow SKEPI commands. The article viewer window has no capability, so article content cannot reach IPC. No shell, no fs, no http plugin.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-zim-open-installed",
    "allow-zim-suggest",
    "allow-zim-search",
    "allow-zim-article",
    "allow-zim-plain-text",
    "allow-viewer-open",
    "allow-viewer-close",
    "allow-llm-load",
    "allow-llm-generate",
    "allow-llm-abort",
    "allow-llm-unload",
    "allow-device-info",
    "allow-content-state",
    "allow-content-reconcile",
    "allow-content-download",
    "allow-content-cancel",
    "allow-content-check-update",
    "allow-content-import",
    "allow-content-verify",
    "allow-content-remove",
    "allow-content-consent",
    "allow-content-choose-folder",
    "allow-settings-get",
    "allow-settings-set",
    "allow-places-query",
    "allow-station-addresses",
    "allow-station-choose-apk",
    "allow-station-start",
    "allow-station-stop",
    "allow-station-status"
  ]
}
