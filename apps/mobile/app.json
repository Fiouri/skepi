{
  "expo": {
    "name": "SKEPI",
    "slug": "skepi",
    "version": "0.2.0-preview",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "skepi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.skepi.app",
      "buildNumber": "5",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "S.K.E.P.I.",
        "NSLocationWhenInUseUsageDescription": "S.K.E.P.I. shows your position and direction on the offline map while it is open, and your coordinates in Tools when you ask. Your location is never stored and never leaves the device."
      }
    },
    "android": {
      "package": "org.skepi.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en"
          ]
        }
      ],
      "./plugins/withSkepiAndroid",
      "./plugins/withSkepiIos"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
