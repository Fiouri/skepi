    "bundle-probe": "tsx src/bundle-probe-cli.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.3"
  }
}
